{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OLCF Helm chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "workerImage": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "controlPlane": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "publicUrl": {
          "type": "string",
          "pattern": "^(https?://[^\\s]+)?$"
        },
        "trustedProxies": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "embeddedWorker": {
          "type": "boolean"
        },
        "logLevel": {
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ]
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string"
              },
              "valueFrom": {
                "type": "object"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ]
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "podLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "topologySpreadConstraints": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "priorityClassName": {
          "type": "string"
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]+%$"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "extraVolumes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraVolumeMounts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "runAsNonRoot": {
          "const": true
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 0
        },
        "fsGroup": {
          "type": "integer",
          "minimum": 0
        },
        "seccompProfile": {
          "type": "object"
        }
      },
      "required": [
        "runAsNonRoot"
      ],
      "additionalProperties": true
    },
    "containerSecurityContext": {
      "type": "object",
      "properties": {
        "allowPrivilegeEscalation": {
          "const": false
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "object"
        }
      },
      "required": [
        "allowPrivilegeEscalation"
      ],
      "additionalProperties": true
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "accessMode": {
          "enum": [
            "ReadWriteOnce",
            "ReadWriteMany",
            "ReadWriteOncePod"
          ]
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi)$"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "properties": {
        "external": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^(postgresql(\\+psycopg)?://.+)?$"
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "bundled": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string",
              "minLength": 1
            },
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi)$"
            },
            "storageClass": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "adminPassword": {
          "type": "string"
        },
        "adminPasswordKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^/"
                    },
                    "pathType": {
                      "enum": [
                        "Prefix",
                        "Exact",
                        "ImplementationSpecific"
                      ]
                    }
                  },
                  "required": [
                    "path",
                    "pathType"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "host",
              "paths"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "secretName": {
                "type": "string",
                "minLength": 1
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "secretName"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "spark": {
      "type": "object",
      "properties": {
        "ports": {
          "type": "object",
          "properties": {
            "masterRpc": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "end": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            "masterUi": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "end": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            "workerRpc": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "end": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            "workerUi": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "end": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            "driverUi": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "end": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            "driver": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "end": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            "blockManager": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "end": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "masterRpc",
            "masterUi",
            "workerRpc",
            "workerUi",
            "driverUi",
            "driver",
            "blockManager"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ports"
      ],
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "allowIngressFromAnywhere": {
          "type": "boolean"
        },
        "egressAllowAll": {
          "type": "boolean"
        },
        "monitoring": {
          "type": "object",
          "properties": {
            "ingressFrom": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "egressTo": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        },
        "workerIngressFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "egress": {
          "type": "object",
          "properties": {
            "dns": {
              "type": "object",
              "properties": {
                "namespaceSelector": {
                  "type": "object"
                },
                "podSelector": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            },
            "database": {
              "type": "object",
              "properties": {
                "cidrs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
                  }
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "additionalProperties": false
            },
            "https": {
              "type": "object",
              "properties": {
                "cidrs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
                  }
                },
                "ports": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              },
              "additionalProperties": false
            },
            "apiServer": {
              "type": "object",
              "properties": {
                "cidrs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
                  }
                },
                "ports": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              },
              "additionalProperties": false
            },
            "extra": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "workers": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "pool": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "string",
          "pattern": "^([A-Za-z0-9_.\\-/]+=[A-Za-z0-9_.\\-/]*)?(,[A-Za-z0-9_.\\-/]+=[A-Za-z0-9_.\\-/]*)*$"
        },
        "maxJobs": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "pattern": "^((https?|wss?)://[^\\s]+)?$"
        },
        "insecureInCluster": {
          "type": "boolean"
        },
        "advertiseHost": {
          "type": "string"
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ]
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "persistence": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi)$"
            },
            "storageClass": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "enrollment": {
          "type": "object",
          "properties": {
            "ttlSeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 2592000
            },
            "hookImage": {
              "type": "string"
            },
            "adminUser": {
              "type": "string",
              "minLength": 1
            },
            "apiTokenSecret": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string"
              },
              "valueFrom": {
                "type": "object"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        },
        "extraVolumes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraVolumeMounts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "kubernetesProvider": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "tests": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "runtimeTrust": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "existingConfigMap": {
          "type": "string"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/[^\\s]+$"
        }
      },
      "additionalProperties": false
    }
  }
}
