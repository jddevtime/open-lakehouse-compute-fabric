# /etc/olcf/olcf.env - mode 0640, owner root, group olcf.  systemd EnvironmentFile syntax: KEY=value, no quotes needed, no `export`.
# Generate keys with:   python3 -c 'import base64,os;print(base64.b64encode(os.urandom(32)).decode())'
#
# Keys (when unset the server creates files under /var/lib/olcf/secrets on first start - fine for one machine; set them for replicas or when you
# want the keys outside the data directory):
#OLCF_MASTER_KEY=
#OLCF_JWT_SIGNING_KEY=
#
# PostgreSQL instead of the default SQLite file (needs the `postgres` extra):
#OLCF_DB__URL=postgresql+psycopg://olcf:CHANGE-ME@127.0.0.1:5432/olcf
#
# Public URL when behind a reverse proxy, and how many proxy hops to trust:
#OLCF_PUBLIC_URL=https://olcf.example.com
#OLCF_SERVER__TRUSTED_PROXIES=1
