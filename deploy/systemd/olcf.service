#
# OLCF control plane as a hardened system service.
#   sudo scripts/install.sh --prefix /opt/olcf --data-dir /var/lib/olcf --no-init      (or any install that provides /opt/olcf/current/bin/olcf)
#   sudo systemd-sysusers deploy/systemd/olcf.sysusers && sudo systemd-tmpfiles --create deploy/systemd/olcf.tmpfiles
#   sudo install -d -m 0750 -o root -g olcf /etc/olcf && sudo install -m 0640 -o root -g olcf deploy/systemd/olcf.env.example /etc/olcf/olcf.env
#   sudo cp deploy/systemd/olcf.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo -u olcf /opt/olcf/current/bin/olcf --data-dir /var/lib/olcf init --admin-password-stdin   (first start only)
#   sudo systemctl enable --now olcf
# Secrets (master key, JWT key, database URL) belong in /etc/olcf/olcf.env (mode 0640 root:olcf), never in this file.
[Unit]
Description=Open Lakehouse Compute Fabric - control plane
Documentation=https://github.com/jddevtime/open-lakehouse-compute-fabric/tree/main/docs
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=olcf
Group=olcf
UMask=0077
WorkingDirectory=/var/lib/olcf
EnvironmentFile=-/etc/olcf/olcf.env
Environment=OLCF_DATA_DIR=/var/lib/olcf
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/olcf/current/bin/olcf --data-dir /var/lib/olcf serve --host 127.0.0.1 --port 8470
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=mixed
KillSignal=SIGTERM

# --- sandbox -------------------------------------------------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/olcf
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
# the embedded Spark worker runs a JVM, which needs writable+executable memory: do NOT set MemoryDenyWriteExecute=true
LimitNOFILE=65536
TasksMax=4096

[Install]
WantedBy=multi-user.target
