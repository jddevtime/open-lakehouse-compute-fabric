# syntax=docker/dockerfile:1.7
# SPDX-License-Identifier: Apache-2.0
# Copyright (c) 2026 Justin Dodrill
#
# OLCF worker agent (Spark runs here).  Joins a control plane with a single-use enrolment token; state (identity, runtimes, work directory) lives in /var/lib/olcf-worker.
#
#   docker build -f deploy/Dockerfile.worker -t olcf-worker:local .
#   docker run -d --init -v olcf-worker:/var/lib/olcf-worker -e OLCF_WORKER_URL=https://olcf.example.com -e OLCF_WORKER_TOKEN=<token> olcf-worker:local
#
# Same layout as deploy/Dockerfile (wheels-only virtualenv, Temurin JRE copied from the official image, non-root uid 10001).
# NOTE: written without access to a Docker daemon; not built yet.

ARG PYTHON_IMAGE=python:3.13-slim-bookworm
ARG JRE_IMAGE=eclipse-temurin:21-jre-jammy
ARG UV_VERSION=0.11.32
# Directory inside the build context with the public keys (*.pub) that sign your runtime manifests; the worker entrypoint exports OLCF_RUNTIME_TRUST_DIR to it.
# The image is not built with a Spark runtime (the control plane installs one on the worker), so the development key is never needed here.
ARG RUNTIME_TRUST_DIR=deploy/runtime-trust

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv
FROM ${JRE_IMAGE} AS jre_src

FROM ${PYTHON_IMAGE} AS build
ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 UV_PYTHON_DOWNLOADS=never UV_NO_PROGRESS=1
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /src
COPY pyproject.toml README.md ./
COPY src ./src
COPY schemas ./schemas
RUN uv build --wheel --out-dir /wheels
RUN uv venv --python /usr/local/bin/python /opt/olcf \
 && WHEEL="$(ls /wheels/olcf-*.whl)" \
 && uv pip install --python /opt/olcf/bin/python --only-binary :all: "olcf @ file://${WHEEL}" \
 && /opt/olcf/bin/olcf-worker --version

FROM ${PYTHON_IMAGE} AS final
ARG RUNTIME_TRUST_DIR
LABEL org.opencontainers.image.title="OLCF worker" org.opencontainers.image.licenses="Apache-2.0" org.opencontainers.image.authors="Justin Dodrill"
RUN apt-get update \
 && apt-get install -y --no-install-recommends tini ca-certificates procps \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 10001 olcf \
 && useradd --system --uid 10001 --gid 10001 --home-dir /var/lib/olcf-worker --shell /usr/sbin/nologin olcf \
 && mkdir -p /var/lib/olcf-worker && chown 10001:10001 /var/lib/olcf-worker
COPY --from=jre_src /opt/java/openjdk /opt/java/openjdk
COPY --from=build /opt/olcf /opt/olcf
COPY ${RUNTIME_TRUST_DIR}/ /etc/olcf/runtime-trust/
COPY deploy/docker/worker-entrypoint.sh /usr/local/bin/olcf-worker-entrypoint
RUN chmod 0755 /usr/local/bin/olcf-worker-entrypoint
ENV PATH=/opt/olcf/bin:/opt/java/openjdk/bin:$PATH \
    JAVA_HOME=/opt/java/openjdk OLCF_JAVA_HOME=/opt/java/openjdk \
    OLCF_WORKER_STATE_DIR=/var/lib/olcf-worker HOME=/var/lib/olcf-worker \
    PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
WORKDIR /var/lib/olcf-worker
VOLUME ["/var/lib/olcf-worker"]
# Spark driver / block manager ports are announced to the control plane; publish or use host networking when workers and the control plane are on different hosts.
EXPOSE 41000-41199
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 CMD ["/opt/olcf/bin/olcf-worker", "status", "--json"]
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/olcf-worker-entrypoint"]
CMD ["run"]
