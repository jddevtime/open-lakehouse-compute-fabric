# Environment for deploy/docker-compose.yml.  Copy to .env (same directory) and fill in, or run  sh deploy/scripts/gen-env.sh  which writes .env with fresh random
# secrets and mode 0600.  NEVER commit .env.  Lines with an empty value fall back to the default shown in the compose file.

# ---- required secrets ---------------------------------------------------------------------------------------------------------------------------------------
# 32 random bytes, base64:  openssl rand -base64 32
# Encrypts every stored secret.  LOSING IT MAKES STORED SECRETS AND MASTER-KEY BACKUPS UNREADABLE - keep an offline copy.
OLCF_MASTER_KEY=
# signs login tokens:  openssl rand -base64 48 | tr '+/' '-_'
OLCF_JWT_SIGNING_KEY=
# first administrator's password (>= 12 characters).  Empty: one is generated and printed once in `docker compose logs`.
OLCF_ADMIN_PASSWORD=

# ---- cluster profile -----------------------------------------------------------------------------------------------------------------------------------------
# hex only (it is embedded in a URL):  openssl rand -hex 24
POSTGRES_PASSWORD=
MINIO_ROOT_USER=olcfminio
MINIO_ROOT_PASSWORD=
OLCF_LAKEHOUSE_BUCKET=olcf-lakehouse

# ---- network -------------------------------------------------------------------------------------------------------------------------------------------------
# Address the published port binds to.  127.0.0.1 = this machine only.  Use 0.0.0.0 only behind TLS and a firewall.
OLCF_BIND=127.0.0.1
OLCF_PORT=8470
# Externally visible URL (needed for enrolment commands, OIDC redirects, Fabric snippets) when behind a proxy / on another host name.
OLCF_PUBLIC_URL=
# number of reverse-proxy hops to trust for X-Forwarded-* (0 = none)
OLCF_TRUSTED_PROXIES=0

# ---- images and build ----------------------------------------------------------------------------------------------------------------------------------------
# OLCF_IMAGE=ghcr.io/jddevtime/olcf:0.1.0           (placeholder until the project is published; unset = build from this checkout)
# OLCF_WORKER_IMAGE=ghcr.io/jddevtime/olcf-worker:0.1.0
# pip extras compiled into the image (wheels only): postgres,s3,azure,k8s,keyring,iceberg,ldap,sftp,zstd or all
OLCF_EXTRAS=postgres,s3,k8s
# Bake a Spark runtime into the image (large; otherwise install it after start:  docker compose exec olcf olcf runtime install)
#   development try-out: an id of a bundled manifest (olcf-rt-2.0.0), set OLCF_ENVIRONMENT=development below; the key is trusted only in the build stage
#   production: the file name of YOUR signed manifest inside OLCF_RUNTIME_TRUST_BUILD_DIR (olcf-rt-2.0.0.json)
OLCF_BAKE_RUNTIME=
# Directory in the build context with the public keys (*.pub) that sign your runtime manifests (default deploy/runtime-trust, empty); copied into the images
# and exported as OLCF_RUNTIME_TRUST_DIR at start.  Workers (cluster profile) need the same keys.
# OLCF_RUNTIME_TRUST_BUILD_DIR=deploy/runtime-trust
# Containers run as production (the OLCF development runtime-signing key is NOT trusted).  For a local try-out only:
# OLCF_ENVIRONMENT=development
OLCF_MEMORY_LIMIT=8g
OLCF_WORKER_POOL=default
OLCF_WORKER_MAX_JOBS=2

# ---- TLS proxy (profile "tls") -------------------------------------------------------------------------------------------------------------------------------
OLCF_DOMAIN=localhost
OLCF_HTTPS_PORT=443
OLCF_HTTP_PORT=80
OLCF_PROXY_BIND=127.0.0.1
# allinone: http://olcf:8470 (default)   cluster: https://control-plane:8470
# OLCF_UPSTREAM=https://control-plane:8470
