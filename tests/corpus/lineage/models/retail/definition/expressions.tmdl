expression ServerName = "analytics.example.com" meta [IsParameterQueryRequired=true, Type=type text, IsParameterQuery=true]
	lineageTag: aaaaaaaa-0000-4000-8000-000000000001

expression DatabaseName = "erp" meta [IsParameterQueryRequired=true, Type=type text, IsParameterQuery=true]

expression SilverLakehouse =
		let
		    Source = Lakehouse.Contents(null),
		    Workspace = Source{[workspaceId="11111111-1111-4111-8111-111111111111"]}[Data],
		    Lakehouse = Workspace{[lakehouseId="22222222-2222-4222-8222-222222222222"]}[Data]
		in
		    Lakehouse

expression DatabaseQuery =
		let
		    database = Sql.Database("abc123.datawarehouse.fabric.microsoft.com", "silver")
		in
		    database
