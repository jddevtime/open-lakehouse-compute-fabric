                    "linkedService": {"properties": {"type": "DataWarehouse", "typeProperties": {"workspaceId": "bbbbbbbb-0000-4000-8000-000000000002", "artifactId": "dddddddd-0000-4000-8000-000000000004", "rootFolder": "Tables"}}}}},
         "translator": {"type": "TabularTranslator", "mappings": [
