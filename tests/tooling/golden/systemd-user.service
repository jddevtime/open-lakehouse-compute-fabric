# Generated by `olcf service install`; edit with `systemctl edit olcf` rather than this file.
[Unit]
Description=Open Lakehouse Compute Fabric server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/u/.olcf
Environment=OLCF_DATA_DIR=/home/u/.olcf
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/olcf/current/bin/olcf --data-dir /home/u/.olcf serve --port 8470
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillMode=mixed
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=default.target
